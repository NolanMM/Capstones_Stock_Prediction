				"          ipoDate as date,",
				"          defaultImage as boolean,",
				"          isEtf as boolean,",
				"          isActivelyTrading as boolean,",
				"          isAdr as boolean,",
				"          isFund as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     batchSize: 10000,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> BronzeCompanyInformation",
				"source(output(",
				"          Open as double,",
				"          High as double,",
				"          Low as double,",
				"          Close as double,",
				"          Volume as integer,",
				"          Dividends as double,",
				"          Stock_Symbol as string,",
				"          Stock_Splits as double,",
				"          Date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> BronzeHistoricalPrices",
				"source(output(",
				"          id as long,",
				"          category as string,",
				"          datetime as timestamp,",
				"          headline as string,",
				"          image as string,",
				"          related as string,",
				"          source as string,",
				"          summary as string,",
				"          url as string,",
				"          symbol as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> BronzeHistoricalStockNews",
				"BronzeCompanyInformation sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          symbol as string,",
				"          price as double,",
				"          beta as double,",
				"          volAvg as integer,",
				"          mktCap as long,",
				"          lastDiv as double,",
				"          range as string,",
				"          changes as double,",
				"          companyName as string,",
				"          currency as string,",
				"          cik as integer,",
				"          isin as string,",
				"          cusip as string,",
				"          exchange as string,",
				"          exchangeShortName as string,",
				"          industry as string,",
				"          website as string,",
				"          description as string,",
				"          ceo as string,",
				"          sector as string,",
				"          country as string,",
				"          fullTimeEmployees as integer,",
				"          phone as string,",
				"          address as string,",
				"          city as string,",
				"          state as string,",
				"          zip as string,",
				"          dcfDiff as double,",
				"          dcf as double,",
				"          image as string,",
				"          ipoDate as date,",
				"          defaultImage as boolean,",
				"          isEtf as boolean,",
				"          isActivelyTrading as boolean,",
				"          isAdr as boolean,",
				"          isFund as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     batchSize: 10000,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> BronzeCompanyInformationBackUpSink",
				"BronzeHistoricalPrices sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Open as double,",
				"          High as double,",
				"          Low as double,",
				"          Close as double,",
				"          Volume as integer,",
				"          Dividends as double,",
				"          Stock_Symbol as string,",
				"          Stock_Splits as double,",
				"          Date as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     batchSize: 10000,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> BronzeHistoricalPricesBackUpSink",
				"BronzeHistoricalStockNews sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as long,",
				"          category as string,",
				"          datetime as timestamp,",
				"          headline as string,",
				"          image as string,",
				"          related as string,",
				"          source as string,",
				"          summary as string,",
				"          url as string,",
				"          symbol as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     batchSize: 10000,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> BronzeHistoricalStockNewsBackUpSink"
			]
		}
	}
}