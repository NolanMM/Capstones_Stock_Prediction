						"type": "DatasetReference"
					},
					"name": "BronzeHistoricalStockNewsBackUpSink"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          symbol as string,",
				"          price as double,",
				"          beta as double,",
				"          volAvg as integer,",
				"          mktCap as long,",
				"          lastDiv as double,",
				"          range as string,",
				"          changes as double,",
				"          companyName as string,",
				"          currency as string,",
				"          cik as integer,",
				"          isin as string,",
				"          cusip as string,",
				"          exchange as string,",
				"          exchangeShortName as string,",
				"          industry as string,",
				"          website as string,",
				"          description as string,",
				"          ceo as string,",
				"          sector as string,",
				"          country as string,",
				"          fullTimeEmployees as integer,",
				"          phone as string,",
				"          address as string,",
				"          city as string,",
				"          state as string,",
